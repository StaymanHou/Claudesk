<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WKWebView's JavaScriptCore JIT. Hardened runtime blocks W+X memory by
	     default; without this the webview degrades or crashes. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- JavaScriptCore also maps executable pages it does not sign. Apple's own
	     guidance pairs this with allow-jit for embedded WebKit. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- Claudesk spawns third-party CLIs it does not control and cannot sign:
	     `claude`, `subl`, `smerge`, `git`, `perl`, and a login shell for PATH
	     capture. Library validation would reject any of these that load a
	     differently-signed dylib. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- The spawned CLIs inherit the PTY and must see the environment Claudesk
	     captured from the login shell. Hardened runtime otherwise scrubs
	     DYLD_*/env inheritance for child processes. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
